{
    "paths": {
        "/AirDefender/deadzones": {
            "get": {
                "summary": "DeadZones status",
                "description": "Whether Air Defender's DeadZones check is loaded and on, any error that turned it off, and for each head set up for DeadZones: where it really is (pan and tilt channel values, allowing for how fast it turns), how many zones it has, and whether its shutter is closed right now and why. Read only.",
                "responses": {
                    "200": {
                        "description": "DeadZones status",
                        "content": {
                            "application/json": {
                                "example": {
                                    "loaded": true,
                                    "enabled": true,
                                    "failed": false,
                                    "error": "",
                                    "frames": 120345,
                                    "heads": [
                                        {
                                            "id": 1,
                                            "name": "Left mover",
                                            "setUp": true,
                                            "closed": true,
                                            "reason": "zone",
                                            "zone": "House",
                                            "pan": 128,
                                            "tilt": 70,
                                            "closes": 3,
                                            "zones": 1
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/AirDefender/deadzones/check": {
            "get": {
                "summary": "Check my sequences: progress and results",
                "description": "The current or last check's progress and results: for each head, the moments its beam is on while it points into a zone.",
                "responses": {
                    "200": {
                        "description": "Progress and results",
                        "content": {
                            "application/json": {
                                "example": {
                                    "busy": false,
                                    "seq": "Bad Romance.fseq",
                                    "progress": 100,
                                    "error": "",
                                    "result": {
                                        "frames": 7200,
                                        "stepMs": 25,
                                        "lengthMs": 180000,
                                        "total": 1,
                                        "heads": [
                                            {
                                                "id": 1,
                                                "name": "Left mover",
                                                "more": false,
                                                "events": [
                                                    {
                                                        "start": 12300,
                                                        "end": 14100,
                                                        "why": "Smith house"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Check my sequences: start or stop",
                "description": "Starts checking one sequence against the DeadZones zones (form field seq=<file>), or stops a check (stop=1). Reads the sequence with FPP's own reader on a low-priority thread, only while nothing is playing, and stops if a sequence starts. Nothing is written.",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "seq": {
                                        "type": "string",
                                        "description": "Sequence file to check, e.g. Carol of the Bells.fseq"
                                    },
                                    "stop": {
                                        "type": "string",
                                        "enum": [
                                            "1"
                                        ],
                                        "description": "Stop the check"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Progress and results",
                        "content": {
                            "application/json": {
                                "example": {
                                    "busy": false,
                                    "seq": "Bad Romance.fseq",
                                    "progress": 100,
                                    "error": "",
                                    "result": {
                                        "frames": 7200,
                                        "stepMs": 25,
                                        "lengthMs": 180000,
                                        "total": 1,
                                        "heads": [
                                            {
                                                "id": 1,
                                                "name": "Left mover",
                                                "more": false,
                                                "events": [
                                                    {
                                                        "start": 12300,
                                                        "end": 14100,
                                                        "why": "Smith house"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "A sequence is playing, or a check is already running"
                    },
                    "400": {
                        "description": "No zones yet, or an unknown sequence name"
                    },
                    "404": {
                        "description": "Sequence not found"
                    }
                }
            }
        }
    }
}
